# Supabase: DATABASE_URL = "Transaction pooler" (porta 6543, com ?pgbouncer=true&connection_limit=1)
#           DIRECT_URL   = "Direct connection" ou "Session pooler" (porta 5432) — usada nas migrações
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails autorizados a criar conta de ADMINISTRADOR no painel (/admin), separados por vírgula.
# Outras pessoas só conseguem criar conta se um ADM cadastrá-las antes em "Usuários".
ADMIN_EMAILS="voce@exemplo.com,outra.pessoa@exemplo.com"

# Envio de e-mails (Gmail SMTP). SMTP_PASS é uma "senha de app" do Gmail, não a senha da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=projeto@gmail.com
SMTP_PASS=
EMAIL_FROM="Semear no Sertão <projeto@gmail.com>"

# Tarefas automáticas (convite do Plano Mantenedor 1 dia após o fim do evento)
# O agendador interno roda de hora em hora enquanto o site está no ar. Para usar só o cron da hospedagem:
# AGENDADOR_INTERNO=desligado
# Senha da rota /api/tarefas/convite-mantenedor (para cron externo ou disparo manual)
CRON_SECRET=troque-por-um-texto-longo-e-aleatorio
